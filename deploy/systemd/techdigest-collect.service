[Unit]
Description=Tech Digest - collect news from all sources
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=techdigest
Group=techdigest
WorkingDirectory=/opt/tech-digest
ExecStart=/opt/tech-digest/.venv/bin/techdigest collect
TimeoutStartSec=10min
Nice=10

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tech-digest/data
