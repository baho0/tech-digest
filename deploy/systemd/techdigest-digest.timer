[Unit]
Description=Tech Digest - send the digest every morning

[Timer]
# Timezone-aware: 07:00 Istanbul time regardless of the server's timezone.
OnCalendar=*-*-* 07:00:00 Europe/Istanbul
# If the server was down at 07:00, run at boot (idempotent per day).
Persistent=true

[Install]
WantedBy=timers.target
