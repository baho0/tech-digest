# --- Database (SQLite now; any SQLAlchemy URL later, e.g. postgresql+psycopg://...) ---
TD_DATABASE_URL=sqlite:///data/techdigest.db

# --- Paths to YAML config ---
TD_SOURCES_FILE=config/sources.yaml
TD_SCORING_FILE=config/scoring.yaml

# --- Digest ---
TD_TIMEZONE=Europe/Istanbul
TD_LOOKBACK_HOURS=24

# --- SMTP (Gmail now: needs an App Password, https://myaccount.google.com/apppasswords) ---
# Switching to your own mail server later = change only these values.
TD_SMTP_HOST=smtp.gmail.com
TD_SMTP_PORT=587
# starttls | ssl | none
TD_SMTP_SECURITY=starttls
TD_SMTP_USER=you@gmail.com
TD_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
TD_MAIL_FROM=Tech Digest <you@gmail.com>
# Comma-separated list
TD_MAIL_TO=you@gmail.com
